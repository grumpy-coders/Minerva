{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Forge userdev client (direct)",
      "request": "launch",
      "mainClass": "net.minecraftforge.bootstrap.ForgeBootstrap",
      "args": "--launchTarget forge_userdev_client --version MOD_DEV --assetIndex 26 --assetsDir ${env:USERPROFILE}\\.gradle\\caches\\forge_gradle\\assets --gameDir .",
      "vmArgs": "-Djava.net.preferIPv4Stack=true",
      "env": {
        "MCP_MAPPINGS": "official_1.21.8",
        "MOD_CLASSES": "${workspaceFolder}\\build\\classes\\java\\main;${workspaceFolder}\\build\\resources\\main"
      },
      "preLaunchTask": "Clean VSCode bin META-INF"
    }
  ]
}