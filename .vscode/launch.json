{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "runClient",
      "request": "launch",
      "mainClass": "net.minecraftforge.bootstrap.ForgeBootstrap",
      "projectName": "Minerva",
      "vmArgs": "-Dforge.logging.console.level=debug -Deventbus.api.strictRuntimeChecks=true -Dforge.enabledGameTestNamespaces=minerva -Dforge.enableGameTest=true -Djava.net.preferIPv6Addresses=system -XX:HeapDumpPath=MojangTricksIntelDriversForPerformance_javaw.exe_minecraft.exe.heapdump",
      "args": "--launchTarget forge_userdev_client --version MOD_DEV --assetIndex 26 --assetsDir ${env:USERPROFILE}/.gradle/caches/forge_gradle/assets --gameDir .",
      "env": {
        "MOD_CLASSES": "${workspaceFolder}\\build\\sourceSets\\main",
        "MCP_MAPPINGS": "official_1.21.8"
      },
      "preLaunchTask": "prepareRunClientCompile"
    },
    {
      "type": "java",
      "name": "runData",
      "request": "launch",
      "mainClass": "net.minecraftforge.bootstrap.ForgeBootstrap",
      "projectName": "Minerva",
      "cwd": "${workspaceFolder}\\run-data",
      "vmArgs": "-Dforge.logging.console.level\u003ddebug -Deventbus.api.strictRuntimeChecks\u003dtrue -Djava.net.preferIPv6Addresses\u003dsystem",
      "args": "--launchTarget forge_userdev_data --assetIndex 26 --assetsDir C:\\Users\\trooker\\.gradle\\caches\\forge_gradle\\assets --gameDir . --mod examplemod --all --output P:\\projects\\Minerva\\src\\generated\\resources --existing P:\\projects\\Minerva\\src\\main\\resources",
      "env": {
        "MOD_CLASSES": "${workspaceFolder}\\build\\sourceSets\\main",
        "MCP_MAPPINGS": "official_1.21.8"
      },
      "preLaunchTask": "prepareRunDataCompile"
    },
    {
      "type": "java",
      "name": "runGameTestServer",
      "request": "launch",
      "mainClass": "net.minecraftforge.bootstrap.ForgeBootstrap",
      "projectName": "Minerva",
      "cwd": "${workspaceFolder}\\run",
      "vmArgs": "-Dforge.logging.console.level\u003ddebug -Deventbus.api.strictRuntimeChecks\u003dtrue -Dforge.enabledGameTestNamespaces\u003dexamplemod -Djava.net.preferIPv6Addresses\u003dsystem",
      "args": "--launchTarget forge_userdev_server_gametest --gameDir .",
      "env": {
        "MOD_CLASSES": "${workspaceFolder}\\build\\sourceSets\\main",
        "MCP_MAPPINGS": "official_1.21.8"
      },
      "preLaunchTask": "prepareRunGameTestServerCompile"
    },
    {
      "type": "java",
      "name": "runServer",
      "request": "launch",
      "mainClass": "net.minecraftforge.bootstrap.ForgeBootstrap",
      "projectName": "Minerva",
      "cwd": "${workspaceFolder}\\run",
      "vmArgs": "-Dforge.logging.console.level\u003ddebug -Deventbus.api.strictRuntimeChecks\u003dtrue -Dforge.enabledGameTestNamespaces\u003dexamplemod -Dforge.enableGameTest\u003dtrue -Djava.net.preferIPv6Addresses\u003dsystem",
      "args": "--launchTarget forge_userdev_server --gameDir . --nogui",
      "env": {
        "MOD_CLASSES": "${workspaceFolder}\\build\\sourceSets\\main",
        "MCP_MAPPINGS": "official_1.21.8"
      },
      "preLaunchTask": "prepareRunServerCompile"
    }
  ]
}